# コンテナはホストの UID で動き、passwd にユーザーがないため、HOME を明示する。
# リポジトリのディレクトリを HOME にして、.claude/ や .bashrc などを残す
HOME=/api

# compose.yaml の db サービスに、サービス名 db で接続する
DATABASE_URL=postgres://developer:password@db:5432/api_dev

# サーバーの待ち受けポート (省略時 3000)。変える場合は compose.yaml の ports も合わせる
# PORT=3000

# 管理画面 (/admin) の Cookie 署名用。ランダムな値 (32 文字以上) にする
# 生成例: openssl rand -base64 48
ADMIN_SECRET=

# true にすると、使ったプロンプトテンプレートを prompt_templates テーブルに保存する (ローカル開発用。本番では有効にしない)
# SAVE_PROMPT_TEMPLATE=false

# LLM (OpenAI) の API キー
OPENAI_API_KEY=
